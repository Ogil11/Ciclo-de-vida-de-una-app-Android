<?xml version="1.0" encoding="utf-8"?>
<!-- Sin permisos: la app no usa internet ni ningún recurso protegido. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Una sola Activity. NO se declara android:configChanges: así, al rotar,
             el sistema destruye y vuelve a crear la Activity (que es lo que queremos ver). -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
